---
import Layout from '../layouts/Layout.astro';
import CarArt from './CarArt.astro';
import {url,repo,fuelNames,timingNames,stale,type Car} from '../lib/cars';
const {car,preview=false}=Astro.props as {car:Car;preview?:boolean};
const source=(id:string)=>car.sources.find(s=>s.id===id)!;
---
<Layout title={`${car.brand} ${car.model} ${car.generation}${preview?' — förhandsvisning':''}`} noindex={preview}>
<div class="wrap"><a class="back" href={url('#modeller')}>← Till bilguiden</a>
{preview && <div class="launch-note"><span class="note-icon">!</span><div><strong>Förhandsvisning — research pågår</strong><p>Det här är ett arbetsunderlag, inte en granskad bilguide. Motoruppgifter, brister och prisnivåer är ännu inte verifierade.</p></div></div>}
<section class="detail-hero"><div><div class="eyebrow accent">{car.brand} / GENERATION {car.generation}</div><h1>{car.model}<span class="accent">.</span></h1><p>{car.summary}</p><div class="detail-tags"><span class="pill">{preview?'UTKAST':'GRANSKAD'}</span><span>Målbudget ≈ {car.budgetTargetSek.toLocaleString('sv-SE')} kr</span></div></div><div class="detail-art"><CarArt id={car.id} tone="#c9d9bd"/><span class="art-note">STILISERAD ILLUSTRATION · EJ MODELLSPECIFIK</span></div></section>
<div class="detail-grid"><div>
{preview ? <section class="panel"><div class="eyebrow accent">NÄSTA STEG</div><h2>Det här undersöker vi.</h2><ol class="research-list">{car.researchTasks.map(task=><li>{task}</li>)}</ol><p class="muted">Saknar du en viktig fråga? Hjälp oss att göra underlaget bättre.</p><a class="text-link" href={`${repo}/issues/new?template=car-data.yml&title=${encodeURIComponent(`[Bildata] ${car.brand} ${car.model}`)}`}>Föreslå en komplettering ↗</a></section> : <>
{stale(car.provenance.reviewedAt)&&<div class="launch-note"><p>Uppdatering behövs: underlaget granskades för mer än sex månader sedan.</p></div>}
<section class="panel"><h2>Motorer & varianter</h2>{car.variants.map(v=><article class="variant" id={v.id}><h3>{v.label}</h3><dl class="specs"><div><dt>Motorkod</dt><dd>{v.engineCodes.join(', ')}</dd></div><div><dt>Årsintervall</dt><dd>{v.yearFrom}–{v.yearTo}</dd></div><div><dt>Drivmedel</dt><dd>{fuelNames[v.fuel]}</dd></div><div><dt>Växellåda</dt><dd>{v.transmission}</dd></div><div><dt>Kamdrivning</dt><dd>{timingNames[v.timingDrive]}</dd></div></dl><div class="source-links">{v.sourceIds.map(id=><a href={source(id).url}>{source(id).title} ↗</a>)}</div></article>)}</section>
<section class="panel"><h2>Brister & kontrollpunkter</h2>{car.issues.length===0?<p>Inga brister har dokumenterats i den här guiden ännu. Det betyder inte att modellen är problemfri.</p>:car.issues.map(issue=><article class="issue"><span class="pill">{issue.evidence==='documented'?'DOKUMENTERAT':'RAPPORTERAT'}</span><h3>{issue.title}</h3><p>{issue.description}</p><p>Berörda varianter: {issue.variantIds.map(id=><a href={`#${id}`}>{car.variants.find(v=>v.id===id)?.label} </a>)}</p><h4>Symptom att uppmärksamma</h4><ul>{issue.symptoms.map(s=><li>{s}</li>)}</ul><h4>Kontrollera före köp</h4><ul>{issue.checks.map(s=><li>{s}</li>)}</ul><div class="source-links">{issue.sourceIds.map(id=><a href={source(id).url}>{source(id).title} ↗</a>)}</div></article>)}</section></>}
<section class="panel"><h2>Källunderlag</h2>{preview?<p>Källgranskningen är inte klar. Inga tekniska slutsatser publiceras i denna förhandsvisning.</p>:<ul class="sources">{car.sources.map(s=><li><a href={s.url}>{s.title} ↗</a><small>Läst {s.accessedAt}</small></li>)}</ul>}</section>
</div><aside><section class="panel provenance"><div class="eyebrow accent">ÖPPET REDOVISAT</div><h2>Bakom guiden</h2><dl><dt>Sammanställning</dt><dd>{car.provenance.method==='ai-assisted'?'AI-assisterad':'Mänskligt skriven'}</dd><dt>AI-leverantör</dt><dd>{car.provenance.provider??'Ej tillämpligt'}</dd><dt>AI-modell</dt><dd>{car.provenance.model??(car.provenance.method==='ai-assisted'?'Ej registrerad — utkast':'Ej tillämpligt')}</dd><dt>Underlag skapat</dt><dd>{car.provenance.generatedAt}</dd><dt>Granskare</dt><dd>{car.provenance.reviewedBy??'Inte granskad'}</dd><dt>Senast granskat</dt><dd>{car.provenance.reviewedAt??'Återstår'}</dd></dl><a href={`${repo}/blob/main/data/cars/${car.id}.json`}>Se data & historik på GitHub ↗</a></section><div class="aside-note"><h3>Varje bil har sin historia.</h3><p>En modellguide ersätter inte kontroll av exemplarets skick, identitet och servicehistorik.</p></div></aside></div></div>
</Layout>
