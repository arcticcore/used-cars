---
import Layout from '../layouts/Layout.astro';
import IssueCard from './IssueCard.astro';
import {url,repo,fuelNames,timingNames,stale,type Car} from '../lib/cars';
const {car,preview=false}=Astro.props as {car:Car;preview?:boolean};
const issues=[...car.issues].sort((a,b)=>a.priority-b.priority);
const options=(key:'bodyStyles'|'transmissions'|'equipment')=>[...new Set(issues.flatMap(i=>i.appliesTo[key]))];
---
<Layout title={`${car.brand} ${car.model} ${car.generation}${preview?' — innehållsutkast':''}`} noindex={preview}>
  <a class="back" href={url()}>← Alla bilmodeller</a>
  <h1>{car.brand} {car.model} <span class="muted">{car.generation}</span></h1>
  <p class="small">Senast granskat: {car.provenance.reviewedAt??'Inte mänskligt granskat'}{stale(car.provenance.reviewedAt)&&' · Uppdatering behövs'}</p>
  {preview&&<div class="notice"><strong>Innehållsutkast – inte färdiggranskat</strong><p>Du kan testa guiden, men motoravgränsningar och slutsatser behöver granskas. Uppgifterna är inte en garanti eller en färdig köprekommendation.</p></div>}
  <section>
    <h2>Bilen i korthet</h2><p>{car.summary}</p>
    <p>{car.focusYears&&<>Fokus: <strong>{car.focusYears.from}–{car.focusYears.to}</strong> (inte generationens hela tillverkningsperiod). </>}Målbudget: cirka {car.budgetTargetSek.toLocaleString('sv-SE')} kr.</p>
    {car.priceObservations.length>0 ? <><p class="small">Prisankare från annonser, inte en marknadsvärdering eller garanti om tillgänglighet:</p><ul class="prices">{car.priceObservations.map(p=><li><strong>{p.priceSek.toLocaleString('sv-SE')} kr</strong> · {p.year} · {p.mileageMil.toLocaleString('sv-SE')} mil<br/>{p.label}<br/><span class="small">Observerat {p.observedAt} · {p.sourceIds.map(id=><a href={`#source-${id}`}>Källa</a>)}</span></li>)}</ul></>:<p class="muted">Prisunderlag saknas ännu.</p>}
  </section>
  <section>
    <h2>Vilken motor ska jag välja?</h2>
    {car.variants.length>0 ? <>
      <p class="small">Välj motorbeteckningen från annonsen. Listan är ett avgränsat urval, inte alla motorer. Exakt motorkod måste stämma innan ett råd kan tillämpas på bilen.</p>
      <div class="filters"><label>Motor<select id="engine"><option value="">Jag vet inte / visa alla</option>{car.variants.map(v=><option value={v.id}>{v.label} · {fuelNames[v.fuel]}</option>)}</select></label>
        {options('transmissions').length>0&&<label>Växellåda<select id="transmission"><option value="">Vet inte / visa alla</option>{[...new Set(['Manuell',...options('transmissions')])].map(t=><option>{t}</option>)}</select></label>}
        {options('bodyStyles').length>0&&<label>Kaross<select id="body"><option value="">Vet inte / visa alla</option>{[...new Set(['Halvkombi','Kombi',...options('bodyStyles')])].map(b=><option>{b}</option>)}</select></label>}
      </div>
      <p id="selection-note" class="notice small" role="status">Motorvariant okänd: alla möjliga varningar visas. Det betyder inte att alla gäller din bil.</p>
      <div class="engine-list">{car.variants.map(v=><article data-engine={v.id}><h3>{v.label} <span class="muted">· {fuelNames[v.fuel]}</span></h3><p>{v.buyerSummary}</p></article>)}</div>
    </>:<p>Motorerna är ännu inte kartlagda. Det går inte att bedöma vilken variant du bör välja utifrån detta utkast.</p>}
  </section>
  <section data-issue-section="other"><h2>Det här bör du se upp med</h2>
    {issues.filter(i=>i.category!=='rust').map(issue=><IssueCard issue={issue}/>)}
    <p data-empty class="muted" hidden={issues.some(i=>i.category!=='rust')}>Inga dokumenterade problem matchar detta val i underlaget. Det betyder inte att varianten är problemfri.</p>
  </section>
  <section data-issue-section="rust"><h2>Rost – titta här</h2>
    {issues.filter(i=>i.category==='rust').map(issue=><IssueCard issue={issue}/>)}
    <p data-empty class="muted" hidden={issues.some(i=>i.category==='rust')}>Vi saknar specifikt rostunderlag för detta val. Kontrollera synlig rost; avsaknad av uppgifter betyder inte att bilen är rostfri.</p>
  </section>
  <section><h2>Vid visningen</h2><p class="small">Allmänna kontrollfrågor, inte en lista över konstaterade modellfel.</p>
    {car.viewingChecklist.length ? <ol class="checklist">{car.viewingChecklist.map(item=><li>{item}</li>)}</ol>:<p class="muted">En modellanpassad checklista återstår.</p>}
  </section>
  <details id="details"><summary>Källor och detaljer</summary>
    <h2>Motoravgränsningar</h2>
    {car.variants.map(v=><div class="technical"><h3>{v.label}</h3><p>Årsurval: {v.yearFrom}–{v.yearTo}. Motorkoder: {v.engineCodes.join(', ')||'Ej verifierade – detta är en motorgrupp, inte en fullständigt identifierad variant.'}</p><p>{v.transmission}. Kamdrivning: {timingNames[v.timingDrive]}.</p><p>{v.sourceIds.map(id=><a class="source-link" href={`#source-${id}`}>{id}</a>)}</p></div>)}
    <h2>Källor</h2><ul class="sources">{car.sources.map(s=><li id={`source-${s.id}`}><a href={s.url}>{s.title} ↗</a><span class="small">Läst {s.accessedAt}</span></li>)}</ul>
    {!car.sources.length&&<p>Källunderlag saknas ännu.</p>}
    <h2>Ursprung och granskning</h2><p>{car.provenance.method==='ai-assisted'?'AI-assisterad sammanställning':'Mänsklig sammanställning'} · {car.provenance.generatedAt}</p><p>Leverantör: {car.provenance.provider??'Ej tillämpligt'}. AI-modell: {car.provenance.model??'Ej registrerad'}. Granskare: {car.provenance.reviewedBy??'Ingen ännu'}.</p>
    {car.researchTasks.length>0&&<><h3>Kvar att undersöka</h3><ul>{car.researchTasks.map(task=><li>{task}</li>)}</ul></>}
    <a href={`${repo}/blob/main/data/cars/${car.id}.json`}>Se data och ändringshistorik ↗</a>
  </details>
  <p><a href={`${repo}/issues/new?template=car-data.yml&title=${encodeURIComponent(`[Bildata] ${car.brand} ${car.model} ${car.generation}`)}`}>Föreslå en rättelse eller komplettering ↗</a></p>
</Layout>
<script>
import {matchesScope} from '../lib/filter.mjs';
const engine=document.querySelector<HTMLSelectElement>('#engine');
const transmission=document.querySelector<HTMLSelectElement>('#transmission');
const body=document.querySelector<HTMLSelectElement>('#body');
function update(){
  const selection={variantIds:engine?.value??'',transmissions:transmission?.value??'',bodyStyles:body?.value??'',equipment:''};
  document.querySelectorAll<HTMLElement>('[data-engine]').forEach(el=>{el.hidden=!!selection.variantIds&&el.dataset.engine!==selection.variantIds;});
  document.querySelectorAll<HTMLElement>('[data-issue]').forEach(el=>{el.hidden=!matchesScope(JSON.parse(el.dataset.scope!),selection);});
  document.querySelectorAll<HTMLElement>('[data-issue-section]').forEach(section=>{section.querySelector<HTMLElement>('[data-empty]')!.hidden=!!section.querySelector('[data-issue]:not([hidden])');});
  const note=document.querySelector('#selection-note');
  if(note) note.textContent=selection.variantIds?'Visar relevanta och gemensamma varningar. Läs alltid ”Gäller” – årsmodell, utrustning och exakt variant kan begränsa rådet. Saknade uppgifter betyder inte att bilen är felfri.':'Motorvariant okänd: alla möjliga varningar visas. Det betyder inte att alla gäller din bil.';
}
[engine,transmission,body].forEach(el=>el?.addEventListener('change',update));
function revealSource(){if(location.hash.startsWith('#source-'))document.querySelector<HTMLDetailsElement>('#details')!.open=true;}
document.querySelectorAll<HTMLAnchorElement>('a[href^="#source-"]').forEach(link=>link.addEventListener('click',()=>{document.querySelector<HTMLDetailsElement>('#details')!.open=true;}));
window.addEventListener('hashchange',revealSource);revealSource();
</script>
