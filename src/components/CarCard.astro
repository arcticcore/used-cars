---
import {url,type Car} from '../lib/cars';
const {car,preview=false} = Astro.props as {car:Car;preview?:boolean};
---
<li class="model-row" data-model data-search={`${car.brand} ${car.model} ${car.generation}`}>
  <a href={url(`${preview?'forhandsvisning':'modeller'}/${car.id}/`)}>
    <div><h3>{car.brand} {car.model} <span>{car.generation}</span></h3>
    <p>{car.focusYears ? `Fokus ${car.focusYears.from}–${car.focusYears.to}` : 'Årsmodeller kartläggs'} · Målbudget cirka {car.budgetTargetSek.toLocaleString('sv-SE')} kr</p></div>
    <span class="row-status">{preview?(car.variants.length?'Se innehållsutkast':'Research pågår'):'Läs guiden'} →</span>
  </a>
</li>
