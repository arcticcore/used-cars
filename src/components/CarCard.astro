---
import CarArt from './CarArt.astro';
import {url, stale, type Car} from '../lib/cars';
const {car,index=0,preview=false} = Astro.props as {car:Car;index?:number;preview?:boolean};
const tones=['#bfcac0','#c8d3e2','#dfc3a3'];
---
<article class="car-card" data-card data-brand={car.brand} data-fuels={car.variants.map(v=>v.fuel).join(' ')} data-search={`${car.brand} ${car.model} ${car.generation}`.toLowerCase()}>
<a class="card-link" href={url(`${preview?'forhandsvisning':'modeller'}/${car.id}/`)}><div class={`car-image tone-${index%3}`}><span class="card-number">0{index+1} / {car.brand.toUpperCase()}</span><span class="pill">{preview?'UNDER ARBETE':'GRANSKAD GUIDE'}</span><CarArt id={car.id} tone={tones[index%3]} compact={index%2===1}/><span class="art-note">ILLUSTRATION</span></div><div class="card-body"><div class="eyebrow">{car.brand} <span>GEN. {car.generation}</span></div><h3>{car.model}<span class="round-arrow">↗</span></h3><p>{preview?'Vi kartlägger motorerna, skillnaderna och frågorna att ställa före köp.':car.summary}</p><div class="card-meta"><span>{preview?'Research pågår':`Granskad ${car.provenance.reviewedAt}`}</span><span>{preview?'Se förhandsvisning':stale(car.provenance.reviewedAt)?'Uppdatering behövs':'Läs guiden'} →</span></div></div></a>
</article>
