---
import Layout from '../layouts/Layout.astro';
import CarCard from '../components/CarCard.astro';
import {reviewed,drafts} from '../lib/cars';
---
<Layout>
  <section class="intro">
    <p class="eyebrow">BEGAGNADE BILAR KRING 100 000 KR</p>
    <h1>Vilken bil tittar du på?</h1>
    <p>Hitta modellen. Jämför motorerna. Se vad du bör kontrollera före köp.</p>
    <label class="search-label" for="model-search">Sök bilmodell</label>
    <input id="model-search" type="search" placeholder="Till exempel Golf, BMW eller Yaris" autocomplete="off"/>
    <p id="search-count" class="small" role="status">{reviewed.length} granskade guider · {drafts.length} utkast</p>
  </section>
  <section data-model-section><h2>Bilguider</h2>
    {reviewed.length ? <ul class="model-list">{reviewed.map(car=><CarCard car={car}/>)}</ul> : <p class="muted">Inga guider är mänskligt granskade ännu. Du kan läsa de tydligt märkta utkasten nedan.</p>}
  </section>
  {drafts.length>0 && <section data-model-section class="draft-section"><h2>Under arbete</h2><p class="small">Innehållsutkast – inte färdiggranskade köpguider.</p><ul class="model-list">{drafts.map(car=><CarCard car={car} preview/>)}</ul></section>}
  <div id="no-results" class="notice" hidden><p>Ingen bilmodell matchar din sökning.</p><button id="reset-search" type="button">Visa alla modeller</button></div>
</Layout>
<script>
import {matchesSearch} from '../lib/filter.mjs';
const input=document.querySelector<HTMLInputElement>('#model-search')!;
const rows=[...document.querySelectorAll<HTMLElement>('[data-model]')];
function update(){
  let count=0;
  for(const row of rows){row.hidden=!matchesSearch(row.dataset.search??'',input.value);if(!row.hidden)count++;}
  document.querySelector('#search-count')!.textContent=`${count} träffar (guider och märkta utkast)`;
  document.querySelector<HTMLElement>('#no-results')!.hidden=count>0;
}
input.addEventListener('input',update);
document.querySelector('#reset-search')?.addEventListener('click',()=>{input.value='';update();input.focus();});
</script>
