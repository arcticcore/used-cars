---
import '../styles/global.css';
import {url,repo} from '../lib/cars';
const {title='Hitta bilmodell och kända problem',description='En enkel guide till motorval, kända problem och kontroller inför köp av begagnad bil i olika prisklasser.',noindex=false} = Astro.props;
---
<!doctype html>
<html lang="sv">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content={description}/><meta name="theme-color" content="#fafaf7"/>
  <title>{title} — Begagnat / 100</title>
  {noindex && <meta name="robots" content="noindex, nofollow"/>}
  <link rel="icon" type="image/svg+xml" href={url('favicon.svg')}/>
</head>
<body>
  <a class="skip" href="#main">Hoppa till innehåll</a>
  <header class="wrap header">
    <a class="logo" href={url()} aria-label="Begagnat 100, startsida">begagnat <span>/ 100</span></a>
    <nav aria-label="Huvudmeny"><a href={url()}>Hitta bil</a><a href={url('metodik/')}>Om guiden</a></nav>
  </header>
  <main id="main" class="wrap"><slot/></main>
  <footer class="wrap">
    <p>Allmän information, ingen garanti för det enskilda exemplaret. Kontrollera bilens skick och servicehistorik.</p>
    <a href={repo}>Bidra eller rätta en uppgift på GitHub ↗</a>
  </footer>
</body>
</html>
